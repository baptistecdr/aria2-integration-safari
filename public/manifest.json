{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "author": "baptistecdr",
  "homepage_url": "https://github.com/baptistecdr/aria2-extensions",
  "description": "__MSG_extDescription__",
  "version": "2.1.3",
  "version_name": "2.1.3 (a36bee5)",
  "default_locale": "en",
  "permissions": ["activeTab", "alarms", "contextMenus", "cookies", "nativeMessaging", "storage"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "browser_style": false
  },
  "icons": {
    "16": "icons/icon-browser-16.png",
    "19": "icons/icon-browser-19.png",
    "24": "icons/icon-browser-24.png",
    "32": "icons/icon-browser-32.png",
    "38": "icons/icon-browser-38.png",
    "48": "icons/icon-browser.svg",
    "80": "icons/icon-browser.svg",
    "96": "icons/icon-browser.svg",
    "128": "icons/icon-browser.svg",
    "256": "icons/icon-browser.svg",
    "512": "icons/icon-browser.svg"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "19": "icons/toolbar-19.png",
      "24": "icons/toolbar.svg",
      "32": "icons/toolbar.svg",
      "38": "icons/toolbar.svg",
      "48": "icons/toolbar.svg",
      "80": "icons/toolbar.svg",
      "128": "icons/toolbar.svg",
      "256": "icons/toolbar.svg",
      "512": "icons/toolbar.svg"
    }
  }
}
